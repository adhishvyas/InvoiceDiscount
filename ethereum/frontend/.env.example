# Sepolia RPC; must accept a 10,000-block eth_getLogs range (not Alchemy's free tier)
VITE_RPC_URL=https://ethereum-sepolia.publicnode.com
# Deployed InvoiceFactory on Sepolia (filled in after node C5, from contracts/deployments/sepolia.json)
VITE_FACTORY_ADDRESS=
# Block the factory was deployed at; the duplicate-reference check and history scan logs from here
VITE_FACTORY_DEPLOY_BLOCK=
# mesh-server origin for Pay with Mesh (its default port is 8788); leave empty to hide Pay with Mesh
VITE_MESH_SERVER_URL=http://localhost:8788
