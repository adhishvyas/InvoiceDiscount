# Mesh dashboard → API keys (Sandbox toggle): client id (public; also sent to the frontend) and client secret.
# Auth is OAuth client credentials against MESH_API_URL/oauth2/token (Mesh Pay v2 API).
MESH_CLIENT_ID=
MESH_API_KEY=
MESH_API_URL=https://api.sbx.meshpay.com
# Link SDK environment returned to the frontend: sbx or prod
MESH_LINK_ENV=sbx
# Signing secret of the webhook endpoint (Account > Webhooks, subscribed to transfer.status_updated; shown once)
MESH_WEBHOOK_SECRET=
# Target network as a CAIP-2 id (Sepolia)
MESH_NETWORK_CAIP2=eip155:11155111
# Mesh-supported tokens as SYMBOL:address, comma-separated (node S1)
MESH_TOKENS=PYUSD:0xCaC524BcA292aaade2DF8A05cC58F0a65B1B3bB9,USDG:0xfBb2A78CceEb415b00300925e464C3E44E6e06b0
# Throwaway testnet key that sends settleDirect() (`cast wallet new`); fund it with Sepolia ETH
SETTLER_PRIVATE_KEY=
# InvoiceFactory whose clones this server accepts (contracts/deployments/sepolia.json)
FACTORY_ADDRESS=0x58B4989074B20af8331C048D7535c70f534299d4
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
# Frontend origin, for CORS; must match the address bar exactly (localhost, not 127.0.0.1)
ALLOWED_ORIGIN=http://localhost:5173
PORT=8788
